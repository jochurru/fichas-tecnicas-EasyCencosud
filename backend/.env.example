# Variables de Entorno del Backend - Fichas Técnicas Easy Cencosud
# Copiar este archivo como '.env' en esta misma carpeta y completar los valores

PORT=3000

# Supabase Credentials (Se requiere Service Role Key para bypass de RLS en Backend)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# Google Gemini Pro API Key (Para extracción inteligente de especificaciones)
GEMINI_API_KEY=your-gemini-pro-api-key

# Clave secreta para la firma y verificación de tokens JWT de sesión
JWT_SECRET=your-secure-jwt-secret-key

# Contraseña de contingencia para la cuenta de administrador (admin@easy.com.ar)
ADMIN_PASSWORD=your-contingency-admin-password
