# Configuración del Servidor
PORT=3000

# Credenciales de Supabase
# URL del proyecto Supabase (ej: https://xyz.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Clave pública Anon o Service Role (se recomienda Service Role en backend para bypass de RLS si es necesario)
SUPABASE_KEY=your-supabase-api-key

# Configuración del Extractor Inteligente (Gemini API)
# Se agregará en las siguientes fases
GEMINI_API_KEY=your-gemini-api-key
